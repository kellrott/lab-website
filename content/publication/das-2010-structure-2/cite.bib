@article{DAS2010,
 abstract = {KPN03535 (gi|152972051) is a putative lipoprotein of unknown function that is secreted by Klebsiella pneumoniae MGH 78578. The crystal structure reveals that despite a lack of any detectable sequence similarity to known structures, it is a novel variant of the OB-fold and structurally similar to the bacterial Cpx-pathway protein NlpE, single-stranded DNA-binding (SSB) proteins and toxins. K. pneumoniae MGH 78578 forms part of the normal human skin, mouth and gut flora and is an opportunistic pathogen that is linked to about 8% of all hospital-acquired infections in the USA. This structure provides the foundation for further investigations into this divergent member of the OB-fold family.},
 author = {Debanu Das and Piotr Kozbial and Gye Won Han and Dennis Carlton and Lukasz Jaroszewski and Polat Abdubek and Tamara Astakhova and Herbert L Axelrod and Constantina Bakolitsa and Connie Chen and Hsiu Ju Chiu and Michelle Chiu and Thomas Clayton and Marc C Deller and Lian Duan and Kyle Ellrott and Marc André Elsliger and Dustin Ernst and Carol L Farr and Julie Feuerhelm and Anna Grzechnik and Joanna C Grant and Kevin K Jin and Hope A Johnson and Heath E Klock and Mark W Knuth and S Sri Krishna and Abhinav Kumar and David Marciano and Daniel McMullan and Mitchell D Miller and Andrew T Morse and Edward Nigoghossian and Amanda Nopakun and Linda Okach and Silvya Oommachen and Jessica Paulsen and Christina Puckett and Ron Reyes and Christopher L Rife and Natasha Sefcovic and Henry J Tien and Christine B Trame and Henry van den Bedem and Dana Weekes and Tiffany Wooten and Qingping Xu and Keith O Hodgson and John Wooley and Ashley M Deacon and Adam Godzik and Scott A Lesley and Ian A Wilson},
 doi = {10.1107/S1744309109018168},
 issn = {1744-3091},
 journal = {Acta crystallographica. Section F, Structural biology and crystallization communications},
 title = {The structure of KPN03535 (gi|152972051), a novel putative lipoprotein from Klebsiella pneumoniae, reveals an OB-fold},
 url = {https://pubmed.ncbi.nlm.nih.gov/20944219/},
 month = {10},
 day = {01},
 year = {2010}
}
