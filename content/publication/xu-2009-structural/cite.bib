@article{XU2009,
 abstract = {SsgA-like proteins (SALPs) are a family of homologous cell division-related proteins that occur exclusively in morphologically complex actinomycetes. We show that SsgB, a subfamily of SALPs, is the archetypal SALP that is functionally conserved in all sporulating actinomycetes. Sporulation-specific cell division of Streptomyces coelicolor ssgB mutants is restored by introduction of distant ssgB orthologues from other actinomycetes. Interestingly, the number of septa (and spores) of the complemented null mutants is dictated by the specific ssgB orthologue that is expressed. The crystal structure of the SsgB from Thermobifida fusca was determined at 2.6 A resolution and represents the first structure for this family. The structure revealed similarities to a class of eukaryotic "whirly" single-stranded DNA/RNA-binding proteins. However, the electro-negative surface of the SALPs suggests that neither SsgB nor any of the other SALPs are likely to interact with nucleotide substrates. Instead, we show that a conserved hydrophobic surface is likely to be important for SALP function and suggest that proteins are the likely binding partners.},
 author = {Qingping Xu and Bjørn A Traag and Joost Willemse and Daniel McMullan and Mitchell D Miller and Marc-André Elsliger and Polat Abdubek and Tamara Astakhova and Herbert L Axelrod and Constantina Bakolitsa and Dennis Carlton and Connie Chen and Hsiu-Ju Chiu and Maksymilian Chruszcz and Thomas Clayton and Debanu Das and Marc C Deller and Lian Duan and Kyle Ellrott and Dustin Ernst and Carol L Farr and Julie Feuerhelm and Joanna C Grant and Anna Grzechnik and Slawomir K Grzechnik and Gye Won Han and Lukasz Jaroszewski and Kevin K Jin and Heath E Klock and Mark W Knuth and Piotr Kozbial and S Sri Krishna and Abhinav Kumar and David Marciano and Wladek Minor and A Mieke Mommaas and Andrew T Morse and Edward Nigoghossian and Amanda Nopakun and Linda Okach and Silvya Oommachen and Jessica Paulsen and Christina Puckett and Ron Reyes and Christopher L Rife and Natasha Sefcovic and Henry J Tien and Christine B Trame and Henry van den Bedem and Shuren Wang and Dana Weekes and Keith O Hodgson and John Wooley and Ashley M Deacon and Adam Godzik and Scott A Lesley and Ian A Wilson and Gilles P van Wezel},
 doi = {10.1074/jbc.M109.018564},
 issn = {1083-351X},
 journal = {The Journal of biological chemistry},
 title = {Structural and functional characterizations of SsgB, a conserved activator of developmental cell division in morphologically complex actinomycetes},
 url = {https://pubmed.ncbi.nlm.nih.gov/19567872/},
 month = {09},
 day = {11},
 year = {2009}
}
