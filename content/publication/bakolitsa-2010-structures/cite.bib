@article{BAKOLITSA2010,
 abstract = {The crystal structures of BB2672 and SPO0826 were determined to resolutions of 1.7 and 2.1 Å by single-wavelength anomalous dispersion and multiple-wavelength anomalous dispersion, respectively, using the semi-automated high-throughput pipeline of the Joint Center for Structural Genomics (JCSG) as part of the NIGMS Protein Structure Initiative (PSI). These proteins are the first structural representatives of the PF06684 (DUF1185) Pfam family. Structural analysis revealed that both structures adopt a variant of the Bacillus chorismate mutase fold (BCM). The biological unit of both proteins is a hexamer and analysis of homologs indicates that the oligomer interface residues are highly conserved. The conformation of the critical regions for oligomerization appears to be dependent on pH or salt concentration, suggesting that this protein might be subject to environmental regulation. Structural similarities to BCM and genome-context analysis suggest a function in amino-acid synthesis.},
 author = {Constantina Bakolitsa and Abhinav Kumar and Kevin K Jin and Daniel McMullan and S Sri Krishna and Mitchell D Miller and Polat Abdubek and Claire Acosta and Tamara Astakhova and Herbert L Axelrod and Prasad Burra and Dennis Carlton and Connie Chen and Hsiu Ju Chiu and Thomas Clayton and Debanu Das and Marc C Deller and Lian Duan and Ylva Elias and Kyle Ellrott and Dustin Ernst and Carol L Farr and Julie Feuerhelm and Joanna C Grant and Anna Grzechnik and Slawomir K Grzechnik and Gye Won Han and Lukasz Jaroszewski and Hope A Johnson and Heath E Klock and Mark W Knuth and Piotr Kozbial and David Marciano and Andrew T Morse and Kevin D Murphy and Edward Nigoghossian and Amanda Nopakun and Linda Okach and Jessica Paulsen and Christina Puckett and Ron Reyes and Christopher L Rife and Natasha Sefcovic and Henry J Tien and Christine B Trame and Christina V Trout and Henry van den Bedem and Dana Weekes and Aprilfawn White and Qingping Xu and Keith O Hodgson and John Wooley and Marc Andre Elsliger and Ashley M Deacon and Adam Godzik and Scott A Lesley and Ian A Wilson},
 doi = {10.1107/S1744309109050647},
 issn = {1744-3091},
 journal = {Acta crystallographica. Section F, Structural biology and crystallization communications},
 title = {Structures of the first representatives of Pfam family PF06684 (DUF1185) reveal a novel variant of the Bacillus chorismate mutase fold and suggest a role in amino-acid metabolism},
 url = {https://pubmed.ncbi.nlm.nih.gov/20944209/},
 year = {2010}
}
